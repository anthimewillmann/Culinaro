    },
    "%lld erstellt" : {
      "comment" : "The subtitle of the Lessons view, showing the number of lessons the user has created.",
      "isCommentAutoGenerated" : true
    },
    "%lld Schritte" : {
      "comment" : "A footnote displaying the number of steps in a lesson. The argument is the number of steps in the lesson.",
      "isCommentAutoGenerated" : true
    },
    "%lld." : {
      "comment" : "A step number in a cooking guide. The number is automatically updated as the user progresses through the steps.",
      "isCommentAutoGenerated" : true
    },
    "%lld. %@" : {
      "comment" : "A text field that allows users to input a list of items. The first argument is the index of the item in the list. The second argument is the string “Zutat” or the string “Schritt”. The third argument is a binding to the array of items. The fourth argument is the index of the item in the list. The fifth argument is the updated value of the item. The sixth argument is the unique",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld. %2$@"
          }
        }
      }
    },
